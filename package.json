  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node backup.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write *.mjs public/*.{js,css,html} tests/*.mjs scripts/*.mjs",
